# ==============================================================================
# Libra Reproduce Backend (Project 2) — Environment Configuration Template
# Copy to `.env` and configure at least ONE live provider for `--mode live`:
#   Option 1: Claude Code CLI OAuth (`claude auth login`) or ANTHROPIC_API_KEY
#   Option 2: OpenAI-compatible API key (DeepSeek / OpenAI) via LLM_API_KEY
# Never commit real API keys to Git.
# ==============================================================================

# Optional: Explicit provider selection ("claude" | "openai" | "simulation" | "")
REPRODUCE_SDK_PROVIDER=

# Option 1 — Anthropic / Claude Agent SDK (0.2.189)
ANTHROPIC_API_KEY=

# Option 2 — OpenAI-compatible tool-calling fallback (e.g., DeepSeek or OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_CONCURRENCY=4

# Optional — Polite OpenAlex pool header for bounded S2 citation queries
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Resource Scheduler Hard Caps
REPRODUCE_MAX_ACTIVE_AGENT_TASKS=4
REPRODUCE_MAX_PARALLEL_EXPERIMENTS=2
REPRODUCE_EXPLORATION_BUDGET_FRACTION=0.20
REPRODUCE_EXPERIMENT_TIMEOUT_SECONDS=180
